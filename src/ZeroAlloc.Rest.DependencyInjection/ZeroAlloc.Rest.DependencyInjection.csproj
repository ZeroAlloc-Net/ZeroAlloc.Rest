<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>ZeroAlloc.Rest.DependencyInjection</PackageId>
    <Description>Microsoft.Extensions.DependencyInjection and IHttpClientFactory integration for ZeroAlloc.Rest: the generated Add{I} registrations, AddRestSerializer and per-client serializers.</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZeroAlloc.Rest\ZeroAlloc.Rest.csproj" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="ZeroAlloc.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
