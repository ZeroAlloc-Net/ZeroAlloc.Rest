<?xml version="1.0" encoding="utf-8"?>
<!--
  ZeroAlloc.Rest v2.0.0: intentional API break, part of the major version bump for #301.

  AddRestResilience now requires TRestClient to be a generated client:
  TRestClient : IGeneratedRestClient<TRestClient>. The bridge builds the client and registers its
  serializers through that interface's static members, so it needs no reflection, no
  ActivatorUtilities, and no manual registration of an interface-level [Serializer] type.
  Hand-written clients no longer satisfy the constraint; docs/migrating-to-v2.md says what to do.

  IsBaselineSuppression is true because the api-compat workflow compares the new package against
  the latest published release, 1.3.x.
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!-- CP0021: new constraint on AddRestResilience's TRestClient -->
  <Suppression>
    <DiagnosticId>CP0021</DiagnosticId>
    <Target>M:ZeroAlloc.Rest.Resilience.RestResilienceServiceCollectionExtensions.AddRestResilience``3(Microsoft.Extensions.DependencyInjection.IServiceCollection,System.Func{``1,System.IServiceProvider,``2},System.Action{ZeroAlloc.Rest.ZeroAllocClientOptions})``1:!:ZeroAlloc.Rest.IGeneratedRestClient{``1}</Target>
    <Left>lib/net10.0/ZeroAlloc.Rest.Resilience.dll</Left>
    <Right>lib/net10.0/ZeroAlloc.Rest.Resilience.dll</Right>
    <IsBaselineSuppression>true</IsBaselineSuppression>
    <Justification>AddRestResilience requires a generated client so it can build it without reflection. Intentional break for v2.0.0, see #301.</Justification>
  </Suppression>
</Suppressions>
