<?xml version="1.0" encoding="utf-8"?>
<!--
  ApiCompat suppressions for intentional API breaks, applied by the api-compat CI job against the
  latest stable release of each package.

  4.0.0: the runtime packages dropped net8.0 and ship net10.0 and net11.0 only, because .NET 8 and
  .NET 9 went out of support on 2026-11-10. Generated with generate-suppression-file against the
  3.8.2 packages; every runtime package reports this one PKV006 and nothing else. Generator, Tools
  and Tools.MSBuild never shipped net8.0, so apicompat lists the entry as unnecessary for them and
  passes. Retire the entry once the baseline is a 4.x release.

  A future intentional break goes here, generated by apicompat in suppression-file mode and
  annotated with its reason.

  Diagnostic-ID reference:
  https://learn.microsoft.com/dotnet/fundamentals/package-validation/diagnostic-ids
-->
<Suppressions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Suppression>
    <DiagnosticId>PKV006</DiagnosticId>
    <Target>net8.0</Target>
  </Suppression>
</Suppressions>
