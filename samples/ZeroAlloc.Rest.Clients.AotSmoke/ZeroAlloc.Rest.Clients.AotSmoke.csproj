<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZeroAlloc.Rest.Clients.AotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>

    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2067;IL2075;IL2091;IL3050;IL3051;IL2104;IL3053;IL2046</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- The provider clients under test; each brings the Rest runtime, serializer and registration packages. -->
    <ProjectReference Include="..\..\src\ZeroAlloc.Rest.Anthropic\ZeroAlloc.Rest.Anthropic.csproj" />
    <ProjectReference Include="..\..\src\ZeroAlloc.Rest.Ollama\ZeroAlloc.Rest.Ollama.csproj" />
  </ItemGroup>
</Project>
