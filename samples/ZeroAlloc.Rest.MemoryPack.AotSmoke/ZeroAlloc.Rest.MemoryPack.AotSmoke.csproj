<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Native AOT runtime proof for MemoryPackRestSerializer's explicit type registration. It is kept apart
    from ZeroAlloc.Rest.AotSmoke because MemoryPack.Core itself reports trim and AOT warnings on every
    AOT publish, whatever code uses it. The main smoke stays at 0 IL warnings.

    TrimmerSingleWarn=false lists each MemoryPack.Core warning with its member, so they stay visible.
    Among them are IL3050 and IL2091, so this project cannot promote those codes to errors the way the
    main smoke does. The aot-smoke-memorypack CI job is the gate instead: it fails on any IL warning,
    of any code, that does not come from a member of MemoryPack.Core.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ZeroAlloc.Rest.MemoryPackAotSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>

    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Rest.MemoryPack\ZeroAlloc.Rest.MemoryPack.csproj" />
    <!-- The MemoryPack package brings its source generator for the [MemoryPackable] records. -->
    <PackageReference Include="MemoryPack" />
  </ItemGroup>
</Project>
