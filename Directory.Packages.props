<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Roslyn -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />
    <!-- Serializers -->
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <!-- MessagePack 3.x bundles the source generator; no separate MessagePack.SourceGenerator package exists for 3.x -->
    <PackageVersion Include="MemoryPack" Version="1.21.4" />
    <!-- OpenAPI -->
    <PackageVersion Include="Microsoft.OpenApi.Readers" Version="1.6.31" />
    <!-- CLI -->
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing.XUnit" Version="1.1.2" />
    <PackageVersion Include="WireMock.Net" Version="2.30.0" />
    <!--
      GHSA-6527-9fp8-r4x6 hits Microsoft.AspNetCore.WebUtilities 2.3.0 to 2.3.13. WireMock.Net 2.30.0
      reaches 2.3.0 through WireMock.Net.Shared and Microsoft.AspNetCore.Http 2.3.9, and no newer
      WireMock.Net exists. The two WireMock test projects reference this directly to lift it to the
      patched release. Drop it once WireMock.Net no longer pulls the 2.x ASP.NET Core packages.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="2.3.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <!-- net8.0 only: ZeroAlloc.Rest.SystemTextJson brings it so net8.0 has the net10.0 serializer. -->
    <PackageVersion Include="System.Text.Json" Version="10.0.14" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net100" Version="1.8.14" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net110" Version="1.8.14" />
    <PackageVersion Include="Basic.Reference.Assemblies.Net80" Version="1.8.14" />
    <!--
      MSBuild task references must not be newer than the MSBuild that loads the task.
      The .NET 10 SDK ships MSBuild 18.9; 18.10 and later target net11.0 only.
      renovate.json holds these below 18.10 until the repo moves to .NET 11.
    -->
    <PackageVersion Include="Microsoft.Build.Framework" Version="18.9.6" />
    <PackageVersion Include="Microsoft.Build.Utilities.Core" Version="18.9.6" />
    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="Refit" Version="16.4.0" />
    <!-- Analyzers -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.322" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <!-- ZeroAlloc ecosystem -->
    <PackageVersion Include="ZeroAlloc.Results" Version="1.4.5" />
    <PackageVersion Include="ZeroAlloc.TestHelpers" Version="1.10.0" />
    <PackageVersion Include="ZeroAlloc.Collections" Version="1.2.5" />
    <PackageVersion Include="ZeroAlloc.Analyzers" Version="1.13.0" />
    <PackageVersion Include="ZeroAlloc.ValueObjects" Version="2.3.1" />
    <PackageVersion Include="ZeroAlloc.Resilience" Version="3.4.0" />
  </ItemGroup>
</Project>